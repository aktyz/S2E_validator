# Settings of the validator service: /etc/s2e/validator.env on the server
# (root:s2e, mode 0640). The real file holds two secrets: S2E_API_KEY, and
# possibly a provider key inside S2E_RPC_URL. The signing key is a separate
# file that only the service user can read.
#
# Every variable is explained in src/s2e_validator/api/main.py.

# dry-run settles nothing and says so in every answer. Switch to solana once
# the program is deployed and the run names this server's key.
S2E_CHAIN=dry-run

S2E_PIPELINE_CONFIG=/etc/s2e/campaign.json
S2E_BATCH_LOG=/var/lib/s2e/batches.sqlite

# What the demo site's backend sends as "Authorization: Bearer <key>".
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# This line is the one secret in this file.
S2E_API_KEY=

# Reward base units per quality point, and the reward mint's decimals.
S2E_UNITS_PER_POINT=1
S2E_REWARD_DECIMALS=6
# The most one submission can ever be paid, in base units. Required: the
# program does not cap a single payout, so this is the only limit.
S2E_MAX_UNITS_PER_SUBMISSION=

# --- only with S2E_CHAIN=solana ---
#S2E_RPC_URL=https://api.devnet.solana.com
#S2E_PROGRAM_ID=
#S2E_SURVEY_ID=0
#S2E_RUN_ID=0
#S2E_NETWORK=devnet
#S2E_VALIDATOR_KEYPAIR=/var/lib/s2e/keys/devnet-validator.json
#S2E_VALIDATOR_PUBKEY=
